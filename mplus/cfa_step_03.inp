TITLE: Refinement step 3 - WLSMV

DATA:
  FILE = "../data/analysis_sample.dat";

VARIABLE:
  NAMES =
    gm1 gm2 gm3 gm4 gm5 gm6 gm7 res1 res2 res3 res4 res5 res6 res7
    sm1 sm2 sm3 sm4 sm5 sm6 sm7 sc1 sc2 sc3 sc4 sc5 sc6 sc7 po1 po2
    po3 po4 po5 po6 po7
  ;
  USEVARIABLES =
    gm2 gm3 gm4 gm6 res1 res2 res3 res4 res5 res6 res7 sm1 sm2 sm3
    sm4 sm5 sm6 sm7 sc1 sc2 sc3 sc4 sc5 sc6 sc7 po1 po2 po3 po4 po5
    po6 po7
  ;
  CATEGORICAL =
    gm2 gm3 gm4 gm6 res1 res2 res3 res4 res5 res6 res7 sm1 sm2 sm3
    sm4 sm5 sm6 sm7 sc1 sc2 sc3 sc4 sc5 sc6 sc7 po1 po2 po3 po4 po5
    po6 po7
  ;
  MISSING = ALL (-999);

ANALYSIS:
  ESTIMATOR = WLSMV;
  PARAMETERIZATION = DELTA;

MODEL:
  GM BY gm2 gm3 gm4 gm6;
  RES BY res1 res2 res3 res4 res5 res6 res7;
  SM BY sm1 sm2 sm3 sm4 sm5 sm6 sm7;
  SC BY sc1 sc2 sc3 sc4 sc5 sc6 sc7;
  PO BY po1 po2 po3 po4 po5 po6 po7;

OUTPUT:
  STDYX; MODINDICES(3.84);
